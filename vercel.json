{
  "rewrites": [
    {
      "source": "/wilstream",
      "destination": "https://wildev-ruby.vercel.app/"
    },
    {
      "source": "/wilstream/:match*",
      "destination": "https://wildev-ruby.vercel.app/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "https://wildev-ruby.vercel.app/assets/:match*"
    },
    {
      "source": "/js/:match*",
      "destination": "https://wildev-ruby.vercel.app/js/:match*"
    }
  ]
}
