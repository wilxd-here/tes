{
  "rewrites": [
    {
      "source": "/xaerimaps",
      "destination": "https://xaerisoftmaps.vercel.app/"
    },
    {
      "source": "/xaerimaps/",
      "destination": "https://xaerisoftmaps.vercel.app/"
    },
    {
      "source": "/xaerimaps/:path*",
      "destination": "https://xaerisoftmaps.vercel.app/:path*"
    },

    {
      "source": "/wilstream",
      "destination": "https://wildev-ruby.vercel.app/"
    },
    {
      "source": "/wilstream/:path*",
      "destination": "https://wildev-ruby.vercel.app/:path*"
    },

    {
      "source": "/api/:path*",
      "destination": "https://wildev-ruby.vercel.app/api/:path*"
    },

    {
      "source": "/XaerisoftAI",
      "destination": "https://jjdkai.vercel.app/"
    },
    {
      "source": "/XaerisoftAI/:path*",
      "destination": "https://jjdkai.vercel.app/:path*"
    }
  ]
}